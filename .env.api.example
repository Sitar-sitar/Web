# External API deployment
API_ONLY=true
CORS_ORIGINS=https://sitar-sitar.github.io

# Optional: enables analytics, feedback, and user storage when a MySQL database is attached.
# Railway MySQL exposes MYSQL_URL; set DATABASE_URL to the same value.
DATABASE_URL=

# Optional Manus-era auth/storage variables. Not required for public UID lookup.
VITE_APP_ID=
JWT_SECRET=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
